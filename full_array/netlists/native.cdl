.SUBCKT inv IN OUT VDD GND
MNM0 OUT IN GND GND g45n1svt W=360n L=45n
MPM0 OUT IN VDD VDD g45p1svt W=360n L=45n
.ENDS inv
.SUBCKT nand3 A B E Y VDD GND
MNM0 Y A n1 GND g45n1svt W=1.08u L=45n
MNM1 n1 B n2 GND g45n1svt W=1.08u L=45n
MNM2 n2 E GND GND g45n1svt W=1.08u L=45n
MPM0 Y A VDD VDD g45p1svt W=360n L=45n
MPM1 Y B VDD VDD g45p1svt W=360n L=45n
MPM2 Y E VDD VDD g45p1svt W=360n L=45n
.ENDS nand3
.SUBCKT and3 A B E Y VDD GND
XNAND A B E nb VDD GND nand3
XBUF nb Y VDD GND inv
.ENDS and3
.SUBCKT nand2 A B Y VDD GND
MN0 Y A n0 GND g45n1svt W=720n L=45n
MN1 n0 B GND GND g45n1svt W=720n L=45n
MP0 Y A VDD VDD g45p1svt W=360n L=45n
MP1 Y B VDD VDD g45p1svt W=360n L=45n
.ENDS nand2
.SUBCKT tg A B EN ENB VDD GND
MN B EN A GND g45n1svt W=1.08u L=45n
MP B ENB A VDD g45p1svt W=1.08u L=45n
.ENDS tg
.SUBCKT precharge_unit BL BLB PCB VDD GND
MP0 BL PCB VDD VDD g45p1svt W=1.08u L=45n
MP1 BLB PCB VDD VDD g45p1svt W=1.08u L=45n
MPEQ BL PCB BLB VDD g45p1svt W=1.08u L=45n
.ENDS precharge_unit
.SUBCKT sense_amp BIT BIT_bar RE VDD GND AMP_OUT
MPM6 nd nd VDD VDD g45p1svt W=1.44u L=45n
MPM5 ns nd VDD VDD g45p1svt W=1.44u L=45n
MPM7 AMP_OUT ns VDD VDD g45p1svt W=360n L=45n
MNM41 ns BIT tail GND g45n1svt W=240n L=45n
MNM40 nd BIT_bar tail GND g45n1svt W=240n L=45n
MNM39 AMP_OUT ns GND GND g45n1svt W=360n L=45n
MNM38 tail RE GND GND g45n1svt W=360n L=45n
.ENDS sense_amp
.SUBCKT read_latch D EN ENB Q VDD GND
XINPUT D n0 EN ENB VDD GND tg
XI0 n0 nb VDD GND inv
XI1 nb Q VDD GND inv
XFEEDBACK Q n0 ENB EN VDD GND tg
.ENDS read_latch
.SUBCKT row_decoder R1 R0 EN WL0 WL1 WL2 WL3 VDD GND
XI0 R0 R0B VDD GND inv
XI1 R1 R1B VDD GND inv
XR0 R1B R0B EN WL0 VDD GND and3
XR1 R1B R0 EN WL1 VDD GND and3
XR2 R1 R0B EN WL2 VDD GND and3
XR3 R1 R0 EN WL3 VDD GND and3
.ENDS row_decoder
.SUBCKT column_decoder C2 C1 C0 CS0 CS1 CS2 CS3 CS4 CS5 VDD GND
XI0 C0 C0B VDD GND inv
XI1 C1 C1B VDD GND inv
XI2 C2 C2B VDD GND inv
XC0 C2B C1B C0B CS0 VDD GND and3
XC1 C2B C1B C0 CS1 VDD GND and3
XC2 C2B C1 C0B CS2 VDD GND and3
XC3 C2B C1 C0 CS3 VDD GND and3
XC4 C2 C1B C0B CS4 VDD GND and3
XC5 C2 C1B C0 CS5 VDD GND and3
.ENDS column_decoder
.SUBCKT rw_control CLK1 CLK2 WR RD C2 C1 WEN WENB REN RENB ROWEN PCB VDD GND
XIRD RD NRD VDD GND inv
XIWR WR NWR VDD GND inv
XIPRE CLK2 PCB VDD GND inv
XBAD C2 C1 VDD BADCOL VDD GND and3
XVALID BADCOL VALID VDD GND inv
XWA WR NRD CLK1 WA VDD GND and3
XRA RD NWR CLK1 RA VDD GND and3
XWE WA VALID PCB WEN VDD GND and3
XRE RA VALID PCB REN VDD GND and3
XIWE WEN WENB VDD GND inv
XIRE REN RENB VDD GND inv
XIDLE WENB RENB VDD IDLE VDD GND and3
XACTIVE IDLE ROWEN VDD GND inv
.ENDS rw_control
.SUBCKT write_driver DIN WEN WENB GBL GBLB VDD GND
XID DIN DINB VDD GND inv
XW0 DIN GBL WEN WENB VDD GND tg
XW1 DINB GBLB WEN WENB VDD GND tg
.ENDS write_driver
.SUBCKT column_mux CS0 CS1 CS2 CS3 CS4 CS5 BL0 BL1 BL2 BL3 BL4 BL5 BLB0 BLB1 BLB2 BLB3 BLB4 BLB5 GBL GBLB VDD GND
XI0 CS0 CSB0 VDD GND inv
XM0P BL0 GBL CS0 CSB0 VDD GND tg
